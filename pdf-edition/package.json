{
  "name": "category-theory-illustrated-pdf-edition",
  "version": "0.1.0",
  "private": true,
  "description": "[Machine Translated, Not Reviewed] Vietnamese translation and editable English book layouts for Category Theory Illustrated",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:vi": "node tools/build.mjs --vi",
    "audit:vi": "python tools/audit_vi.py",
    "build:vi:frontmatter": "node tools/build.mjs --vi-frontmatter",
    "audit": "python tools/audit_fuller.py",
    "review": "python tools/review_book.py",
    "upstream:compare": "node tools/upstream.mjs compare",
    "upstream:accept": "node tools/upstream.mjs accept"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "markdown-it": "14.1.0",
    "mathjax": "3.2.2",
    "pdf-lib": "1.17.1",
    "playwright": "1.62.1"
  }
}
